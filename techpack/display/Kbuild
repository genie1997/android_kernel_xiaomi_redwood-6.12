# Qualcomm's msm/Kbuild takes the display configuration and its header from the environment
export DISPLAY_ROOT := $(srctree)/techpack/display
include $(DISPLAY_ROOT)/config/redwooddisp.conf
export LINUX_INC := -include $(DISPLAY_ROOT)/config/redwooddispconf.h
LINUXINCLUDE += -I$(DISPLAY_ROOT)/include/uapi/display -I$(DISPLAY_ROOT)/include

obj-$(CONFIG_MSM_DRM) += msm/
