config SND_EVENT
	tristate "Audio subsystem event notifier"

config MSM_QDSP6_PDR
	tristate "QDSP6 protection domain restart notifications"
	depends on QCOM_PDR_HELPERS

config MSM_QDSP6_SSR
	bool

config MSM_QDSP6_NOTIFIER
	tristate "QDSP6 audio service notifier"
	depends on QCOM_RPROC_COMMON && QCOM_PDR_HELPERS
	select MSM_QDSP6_PDR
	select MSM_QDSP6_SSR

config MSM_QDSP6_APRV2_RPMSG
	tristate "QDSP6 APR v2 over rpmsg"
	depends on RPMSG && QCOM_SCM
	select SND_EVENT
	select MSM_QDSP6_NOTIFIER

config MSM_ADSP_LOADER
	tristate "ADSP loader"
	depends on MSM_QDSP6_APRV2_RPMSG && REMOTEPROC
	help
	  Boots the ADSP when userspace writes /sys/kernel/boot_adsp/boot.

config SND_SOC_LAHAINA
	tristate "Lahaina sound card"
	depends on SND_SOC && MSM_QDSP6_APRV2_RPMSG && QCOM_SCM && PINCTRL_MSM
	help
	  Builds the lahaina sound card the way Qualcomm's lahaina target
	  does: the q6 DSP interface, the ASoC platform and machine drivers,
	  SoundWire, the LPASS pin controller, bolero with its RX, TX and VA
	  macros, the WCD938x codec and the WCD937x and WSA883x codecs the
	  machine driver calls into.

config SND_SOC_AW882XX
	tristate "Awinic AW882xx smart amplifier"
	depends on I2C && SND_SOC_LAHAINA
	help
	  The AW882xx speaker amplifiers on the primary TDM interface, with
	  their calibration through the ADSP.
